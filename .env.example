# Server & JWT Configuration
PORT=5001
JWT_SECRET=your_secure_jwt_secret_32_chars_long

# Turso Database Configuration (For Vercel Deployment & Permanent Persistence)
TURSO_DATABASE_URL=libsql://don-don-7309.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# Supabase Configuration (For Cloudflare Workers & Vercel)
# Configure SUPABASE_URL as an environment variable (not secret)
# Configure SUPABASE_SERVICE_ROLE_KEY as a Cloudflare Workers secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
